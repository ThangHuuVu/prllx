# GitHub OAuth app. Callback URL: {BETTER_AUTH_URL}/api/auth/callback/github
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Signs session cookies. Generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=

# Public origin of this app, with no trailing slash.
BETTER_AUTH_URL=http://localhost:3000
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Comma-separated account emails allowed to export and share scenes.
EXPORT_ALLOWED_EMAILS=

# Provided when a Vercel Blob store is connected to the project.
BLOB_READ_WRITE_TOKEN=

# Authenticates GET /api/cron/cleanup-scenes.
# On Vercel, the variable must be named CRON_SECRET. Vercel then sends it as
# Authorization: Bearer <CRON_SECRET> on cron invocations. Use a long random value.
CRON_SECRET=
